[[0.0, 2.83, ["Ты выходишь из", "колледжа в 11 вечера."]], [2.86, 4.529999999999999, ["Телефон почти разряжен."]], [4.56, 6.35, ["На остановке никого."]], [6.52, 10.05, ["Через пять минут подъезжает", "старый автобус номер 13."]], [10.22, 11.65, ["Ты заходишь внутрь."]], [11.68, 13.71, ["В салоне сидят семь человек."]], [13.8, 14.85, ["Все молчат."]], [14.96, 17.83, ["Ты оплачиваешь проезд", "и садишься у окна."]], [17.96, 19.35, ["Автобус трогается."]], [19.46, 22.01, ["Через несколько минут", "замечаешь странность."]], [22.12, 25.65, ["За окном снова та же", "остановка, на которой ты сел."]], [25.76, 28.049999999999997, ["Ты думаешь, что", "водитель поехал по кругу."]], [28.08, 31.57, ["Но через минуту остановка", "появляется снова."]], [31.7, 33.15, ["Ты подходишь к водителю."]], [33.18, 35.01, ["Спрашиваешь, куда он едет."]], [35.04, 36.01, ["Тот молчит."]], [36.14, 38.089999999999996, ["Ты касаешься его плеча."]], [38.12, 40.67, ["Водитель медленно", "поворачивает голову."]], [40.74, 42.57, ["У него закрыты глаза."]], [42.82, 44.25, ["Ты отшатываешься."]], [44.28, 46.29, ["Сзади раздаётся", "женский голос:"]], [46.48, 47.77, ["«Не трогай его."]], [47.9, 49.47, ["Он уже давно мёртв»."]], [49.68, 51.15, ["Ты оборачиваешься."]], [51.18, 53.589999999999996, ["На последнем", "сиденье — старуха."]], [53.62, 55.59, ["Она смотрит прямо на тебя."]], [55.82, 56.949999999999996, ["«Садись, мальчик."]], [56.98, 59.73, ["До конечной ещё далеко»."]], [59.9, 61.33, ["Ты бросаешься к дверям."]], [61.36, 63.11, ["Нажимаешь кнопку остановки."]], [63.24, 63.97, ["Ничего."]], [64.26, 66.33, ["В этот момент", "телефон вибрирует."]], [66.36, 68.23, ["Приходит сообщение от мамы:"]], [68.26, 69.59, ["«Сынок, где ты?"]], [69.62, 72.99, ["По новостям сказали, что", "автобус номер 13 разбился»."]], [73.22, 74.73, ["Ты открываешь новость."]], [74.82, 77.57, ["Авария произошла", "двадцать лет назад."]], [77.7, 80.09, ["Погибли водитель и", "семь пассажиров."]], [80.24, 82.27, ["Ты начинаешь считать", "людей в салоне."]], [82.3, 83.42999999999999, ["Один."]], [83.46, 84.33, ["Два."]], [84.4, 85.03, ["Три."]], [85.06, 85.93, ["Четыре."]], [86.08, 86.69, ["Пять."]], [86.72, 87.53, ["Шесть."]], [87.56, 88.53, ["Семь."]], [88.56, 89.89, ["Старуха улыбается."]], [90.04, 92.59, ["«А теперь нас восемь»."]], [92.62, 94.81, ["Внезапно автобус", "резко тормозит."]], [94.84, 96.17, ["Двери открываются."]], [96.2, 98.41, ["За ними — твоя родная улица."]], [98.44, 99.83, ["Ты выбегаешь наружу."]], [99.86, 101.43, ["Автобус уезжает."]], [101.48, 104.53, ["Ты с облегчением достаёшь", "телефон и звонишь маме."]], [104.56, 105.69, ["Она отвечает."]], [105.72, 106.67, ["Ты говоришь:"]], [106.7, 108.31, ["«Мам, я уже дома»."]], [108.64, 109.97, ["Несколько секунд тишины."]], [110.0, 112.63, ["Потом она шёпотом", "произносит:"]], [112.66, 115.21, ["«Сынок, не заходи в квартиру."]], [115.24, 118.01, ["Ты уже пришёл домой", "десять минут назад»."]], [118.28, 120.39, ["Ты медленно", "поднимаешь глаза."]], [120.64, 123.09, ["В окне своей комнаты", "видишь человека."]], [123.22, 124.87, ["Он стоит неподвижно."]], [124.9, 127.11, ["А потом машет тебе рукой."]], [127.14, 128.53, ["И ты понимаешь."]], [128.6, 129.93, ["Это ты сам."]], [130.04, 132.99, ["Только его лицо", "полностью обгорело."]], [133.36, 135.07, ["Продолжение следует."]]]