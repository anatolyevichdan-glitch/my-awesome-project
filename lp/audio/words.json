{
"segments": [
{
"s": 0.0,
"e": 2.68,
"text": "Ты выходишь из колледжа в 11 вечера."
},
{
"s": 2.86,
"e": 4.4,
"text": "Телефон почти разряжен."
},
{
"s": 4.56,
"e": 6.1,
"text": "На остановке никого."
},
{
"s": 6.52,
"e": 9.8,
"text": "Через 5 минут подъезжает старый автобус номер 13."
},
{
"s": 10.22,
"e": 11.58,
"text": "Ты заходишь внутрь."
},
{
"s": 11.68,
"e": 13.46,
"text": "В салоне сидят 7 человек."
},
{
"s": 13.8,
"e": 14.6,
"text": "Все молчат."
},
{
"s": 14.96,
"e": 17.58,
"text": "Ты оплачиваешь проезд и садишься у окна."
},
{
"s": 17.96,
"e": 19.1,
"text": "Автобус трогается."
},
{
"s": 19.46,
"e": 21.76,
"text": "Через несколько минут замечаешь странность."
},
{
"s": 22.12,
"e": 25.4,
"text": "За окном снова та же остановка, на которой ты сел."
},
{
"s": 25.76,
"e": 28.08,
"text": "Ты думаешь, что водитель поехал по кругу."
},
{
"s": 28.08,
"e": 31.32,
"text": "Но через минуту остановка появляется снова."
},
{
"s": 31.7,
"e": 32.98,
"text": "Ты подходишь к водителю."
},
{
"s": 33.18,
"e": 34.9,
"text": "Спрашиваешь, куда он едет."
},
{
"s": 35.04,
"e": 35.76,
"text": "Тот молчит."
},
{
"s": 36.14,
"e": 37.94,
"text": "Ты касаешься его плеча."
},
{
"s": 38.12,
"e": 40.42,
"text": "Водитель медленно поворачивает голову."
},
{
"s": 40.74,
"e": 42.32,
"text": "У него закрыты глаза."
},
{
"s": 42.82,
"e": 44.04,
"text": "Ты отшатываешься."
},
{
"s": 44.28,
"e": 46.04,
"text": "Сзади раздается женский голос."
},
{
"s": 46.48,
"e": 47.52,
"text": "Не трогай его."
},
{
"s": 47.9,
"e": 49.22,
"text": "Он уже давно мертв."
},
{
"s": 49.68,
"e": 50.92,
"text": "Ты оборачиваешься."
},
{
"s": 51.18,
"e": 53.52,
"text": "На последнем сиденье старуха."
},
{
"s": 53.62,
"e": 55.34,
"text": "Она смотрит прямо на тебя."
},
{
"s": 55.82,
"e": 56.98,
"text": "Садись, мальчик."
},
{
"s": 56.98,
"e": 59.48,
"text": "Доконечный еще далеко."
},
{
"s": 59.9,
"e": 61.18,
"text": "Ты бросаешься к дверям."
},
{
"s": 61.36,
"e": 62.86,
"text": "Нажимаешь кнопку остановки."
},
{
"s": 63.24,
"e": 63.72,
"text": "Ничего."
},
{
"s": 64.26,
"e": 66.14,
"text": "В этот момент телефон вибрирует."
},
{
"s": 66.36,
"e": 68.04,
"text": "Приходит сообщение от мамы."
},
{
"s": 68.26,
"e": 69.4,
"text": "Сынок, где ты?"
},
{
"s": 69.62,
"e": 72.74,
"text": "По новостям сказали, что автобус номер 13 разбился."
},
{
"s": 73.22,
"e": 74.48,
"text": "Ты открываешь новость."
},
{
"s": 74.82,
"e": 77.32,
"text": "Авария произошла 20 лет назад."
},
{
"s": 77.7,
"e": 79.84,
"text": "Погибли водитель и 7 пассажиров."
},
{
"s": 80.24,
"e": 82.3,
"text": "Ты начинаешь считать людей в салоне."
},
{
"s": 82.3,
"e": 88.3,
"text": "1, 2, 3, 4, 5, 6, 7."
},
{
"s": 88.56,
"e": 89.64,
"text": "Старуха улыбается."
},
{
"s": 90.04,
"e": 92.54,
"text": "А теперь нас восемь."
},
{
"s": 92.62,
"e": 94.64,
"text": "Внезапно автобус резко тормозит."
},
{
"s": 94.84,
"e": 95.92,
"text": "Двери открываются."
},
{
"s": 96.2,
"e": 98.18,
"text": "За ними твоя родная улица."
},
{
"s": 98.44,
"e": 99.68,
"text": "Ты выбегаешь наружу."
},
{
"s": 99.86,
"e": 101.18,
"text": "Автобус уезжает."
},
{
"s": 101.48,
"e": 104.42,
"text": "Ты с облегчением достаешь телефон и звонишь маме."
},
{
"s": 104.56,
"e": 105.6,
"text": "Она отвечает."
},
{
"s": 105.72,
"e": 106.54,
"text": "Ты говоришь."
},
{
"s": 106.7,
"e": 108.06,
"text": "Мам, я уже дома."
},
{
"s": 108.64,
"e": 110.0,
"text": "Несколько секунд тишины."
},
{
"s": 110.0,
"e": 112.42,
"text": "Потом она шепотом произносит."
},
{
"s": 112.66,
"e": 114.96,
"text": "Сынок, не заходи в квартиру."
},
{
"s": 115.24,
"e": 117.76,
"text": "Ты уже пришел домой 10 минут назад."
},
{
"s": 118.28,
"e": 120.14,
"text": "Ты медленно поднимаешь глаза."
},
{
"s": 120.64,
"e": 122.84,
"text": "В окне своей комнаты видишь человека."
},
{
"s": 123.22,
"e": 124.66,
"text": "Он стоит неподвижно."
},
{
"s": 124.9,
"e": 126.88,
"text": "А потом машет тебе рукой."
},
{
"s": 127.14,
"e": 128.28,
"text": "И ты понимаешь."
},
{
"s": 128.6,
"e": 129.68,
"text": "Это ты сам."
},
{
"s": 130.04,
"e": 132.74,
"text": "Только его лицо полностью обгорело."
},
{
"s": 133.36,
"e": 134.82,
"text": "Продолжение следует."
}
],
