[
 {
  "S": 0.06666666666666667,
  "E": 1.7,
  "text": "Ты идёшь по пустой улице.",
  "red": false
 },
 {
  "S": 2.2666666666666666,
  "E": 4.4,
  "text": "Но за тобой кто-то идёт.",
  "red": false
 },
 {
  "S": 4.933333333333334,
  "E": 5.966666666666667,
  "text": "Ты этого не видишь.",
  "red": false
 },
 {
  "S": 6.4,
  "E": 7.6,
  "text": "Зато видит камера.",
  "red": false
 },
 {
  "S": 8.066666666666666,
  "E": 10.133333333333333,
  "text": "Высокий чёрный силуэт появляется",
  "red": false
 },
 {
  "S": 10.166666666666666,
  "E": 11.6,
  "text": "прямо за твоей спиной.",
  "red": false
 },
 {
  "S": 11.933333333333334,
  "E": 12.966666666666667,
  "text": "Ты ускоряешь шаг.",
  "red": false
 },
 {
  "S": 13.333333333333334,
  "E": 14.033333333333333,
  "text": "Он тоже.",
  "red": false
 },
 {
  "S": 14.333333333333334,
  "E": 15.466666666666667,
  "text": "Ты останавливаешься.",
  "red": false
 },
 {
  "S": 15.866666666666667,
  "E": 17.2,
  "text": "И он замирает.",
  "red": false
 },
 {
  "S": 17.566666666666666,
  "E": 18.666666666666668,
  "text": "Телефон вибрирует.",
  "red": false
 },
 {
  "S": 19.033333333333335,
  "E": 20.866666666666667,
  "text": "Сообщение с неизвестного номера.",
  "red": false
 },
 {
  "S": 21.366666666666667,
  "E": 22.533333333333335,
  "text": "НЕ ОБОРАЧИВАЙСЯ.",
  "red": true
 },
 {
  "S": 22.933333333333334,
  "E": 24.3,
  "text": "Ты резко поднимаешь глаза.",
  "red": false
 },
 {
  "S": 24.633333333333333,
  "E": 26.533333333333335,
  "text": "В отражении витрины видишь себя.",
  "red": false
 },
 {
  "S": 26.9,
  "E": 29.033333333333335,
  "text": "Но за твоей спиной никого нет.",
  "red": false
 },
 {
  "S": 29.4,
  "E": 30.3,
  "text": "Ты выдыхаешь.",
  "red": false
 },
 {
  "S": 30.666666666666668,
  "E": 32.46666666666667,
  "text": "И вдруг замечаешь странность.",
  "red": false
 },
 {
  "S": 32.733333333333334,
  "E": 35.4,
  "text": "Твоё отражение не выдыхает.",
  "red": false
 },
 {
  "S": 35.733333333333334,
  "E": 38.166666666666664,
  "text": "Оно продолжает смотреть прямо на тебя.",
  "red": false
 },
 {
  "S": 38.56666666666667,
  "E": 41.666666666666664,
  "text": "А потом медленно поднимает палец к губам.",
  "red": false
 },
 {
  "S": 42.13333333333333,
  "E": 42.833333333333336,
  "text": "Тсс!",
  "red": false
 },
 {
  "S": 43.3,
  "E": 44.733333333333334,
  "text": "Ты отскакиваешь от витрины.",
  "red": false
 },
 {
  "S": 45.0,
  "E": 47.266666666666666,
  "text": "На телефоне появляется новое сообщение.",
  "red": false
 },
 {
  "S": 47.666666666666664,
  "E": 48.7,
  "text": "ОН НЕ ЗА ТОБОЙ.",
  "red": true
 },
 {
  "S": 49.06666666666667,
  "E": 49.9,
  "text": "Ты замираешь.",
  "red": false
 },
 {
  "S": 50.2,
  "E": 51.4,
  "text": "Приходит следующее.",
  "red": false
 },
 {
  "S": 51.833333333333336,
  "E": 53.3,
  "text": "ОН ВНУТРИ ТЕБЯ.",
  "red": true
 },
 {
  "S": 53.8,
  "E": 56.36666666666667,
  "text": "В этот момент фонари на улице начинают гаснуть.",
  "red": false
 },
 {
  "S": 56.63333333333333,
  "E": 57.333333333333336,
  "text": "Один.",
  "red": false
 },
 {
  "S": 57.4,
  "E": 58.1,
  "text": "Второй.",
  "red": false
 },
 {
  "S": 58.2,
  "E": 58.900000000000006,
  "text": "Третий.",
  "red": false
 },
 {
  "S": 59.1,
  "E": 60.3,
  "text": "Ты бросаешься бежать.",
  "red": false
 },
 {
  "S": 60.6,
  "E": 62.766666666666666,
  "text": "За спиной слышится тяжёлое дыхание.",
  "red": false
 },
 {
  "S": 63.0,
  "E": 65.56666666666666,
  "text": "Ты сворачиваешь во двор и врезаешься в человека.",
  "red": false
 },
 {
  "S": 65.8,
  "E": 66.8,
  "text": "Поднимаешь голову.",
  "red": false
 },
 {
  "S": 67.06666666666666,
  "E": 69.3,
  "text": "Перед тобой стоишь ТЫ САМ.",
  "red": false
 },
 {
  "S": 69.63333333333334,
  "E": 70.56666666666666,
  "text": "Та же одежда.",
  "red": false
 },
 {
  "S": 70.7,
  "E": 71.46666666666667,
  "text": "То же лицо.",
  "red": false
 },
 {
  "S": 71.76666666666667,
  "E": 74.5,
  "text": "Только глаза совершенно чёрные.",
  "red": false
 },
 {
  "S": 74.86666666666666,
  "E": 77.3,
  "text": "Двойник хватает тебя за плечи и шепчет.",
  "red": false
 },
 {
  "S": 77.66666666666667,
  "E": 78.86666666666666,
  "text": "Слушай внимательно.",
  "red": false
 },
 {
  "S": 79.2,
  "E": 81.16666666666667,
  "text": "Ты должен перестать убегать.",
  "red": false
 },
 {
  "S": 81.5,
  "E": 82.76666666666667,
  "text": "Ты пытаешься вырваться,",
  "red": false
 },
 {
  "S": 82.96666666666667,
  "E": 84.96666666666667,
  "text": "но он смотрит куда-то за твою спину.",
  "red": false
 },
 {
  "S": 85.3,
  "E": 86.46666666666667,
  "text": "Его лицо меняется.",
  "red": false
 },
 {
  "S": 86.7,
  "E": 87.60000000000001,
  "text": "Впервые он",
  "red": false
 },
 {
  "S": 87.63333333333334,
  "E": 89.83333333333333,
  "text": "выглядит по-настоящему испуганным.",
  "red": false
 },
 {
  "S": 90.23333333333333,
  "E": 90.93333333333334,
  "text": "НЕТ.",
  "red": true
 },
 {
  "S": 91.2,
  "E": 92.66666666666667,
  "text": "ОН НАШЁЛ НАС ОБОИХ.",
  "red": true
 },
 {
  "S": 93.03333333333333,
  "E": 94.9,
  "text": "Ты медленно поворачиваешь голову.",
  "red": false
 },
 {
  "S": 95.23333333333333,
  "E": 96.46666666666667,
  "text": "На крыше девятиэтажки",
  "red": false
 },
 {
  "S": 96.5,
  "E": 98.73333333333333,
  "text": "стоит огромная чёрная фигура.",
  "red": false
 },
 {
  "S": 99.0,
  "E": 102.46666666666667,
  "text": "Она наклоняется вниз и произносит твоим голосом.",
  "red": false
 },
 {
  "S": 102.86666666666666,
  "E": 104.76666666666667,
  "text": "КТО ИЗ ВАС НАСТОЯЩИЙ?",
  "red": true
 },
 {
  "S": 105.36666666666666,
  "E": 106.26666666666667,
  "text": "Чёрный экран.",
  "red": false
 },
 {
  "S": 106.66666666666667,
  "E": 108.26666666666667,
  "text": "Продолжение следует.",
  "red": false
 }
]