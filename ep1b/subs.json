[[1, 0.0, 1.85, "Ты идёшь по пустой улице."], [2, 2.12, 4.51, "Но за тобой кто-то идёт."], [3, 4.8, 6.11, "Ты этого не видишь."], [4, 6.26, 7.71, "Зато видит камера."], [5, 8.06, 11.63, "Высокий чёрный силуэт появляется\nпрямо за твоей спиной."], [6, 11.9, 12.77, "Ты ускоряешь шаг."], [7, 13.3, 13.99, "Он тоже."], [8, 14.3, 15.63, "Ты останавливаешься."], [9, 15.8, 16.41, "И он замирает."], [10, 17.6, 18.81, "Телефон вибрирует."], [11, 19.0, 20.95, "Сообщение с неизвестного номера:"], [12, 21.2, 22.65, "«Не оборачивайся»."], [13, 22.9, 24.33, "Ты резко поднимаешь глаза."], [14, 24.6, 26.36, "В отражении витрины видишь себя."], [15, 26.4, 29.13, "Но за твоей спиной никого нет."], [16, 29.3, 30.37, "Ты выдыхаешь."], [17, 30.6, 32.57, "И вдруг замечаешь странность."], [18, 32.8, 35.45, "Твоё отражение не выдыхает."], [19, 35.7, 38.23, "Оно продолжает смотреть прямо на тебя."], [20, 38.5, 41.79, "А потом медленно поднимает\nпалец к губам."], [21, 42.1, 43.15, "Тсс!"], [22, 43.2, 44.85, "Ты отскакиваешь от витрины."], [23, 44.9, 47.31, "На телефоне появляется\nновое сообщение:"], [24, 47.6, 48.73, "«Он не за тобой»."], [25, 49.0, 50.01, "Ты замираешь."], [26, 50.1, 51.47, "Приходит следующее."], [27, 51.7, 53.33, "«Он внутри тебя»."], [28, 53.7, 54.76, "В этот момент фонари на улице"], [29, 54.8, 56.26, "начинают гаснуть."], [30, 56.3, 58.660000000000004, "Один. Второй. Третий."], [31, 58.7, 60.160000000000004, "Ты бросаешься бежать."], [32, 60.2, 62.56, "За спиной слышится тяжёлое дыхание."], [33, 62.6, 64.05999999999999, "Ты сворачиваешь во двор"], [34, 64.1, 65.25999999999999, "и врезаешься в человека."], [35, 65.3, 66.75999999999999, "Поднимаешь голову."], [36, 66.8, 69.75999999999999, "Перед тобой стоишь ты сам."], [37, 69.8, 71.36, "Та же одежда. То же лицо."], [38, 71.4, 74.36, "Только глаза совершенно чёрные."], [39, 74.4, 76.05999999999999, "Двойник хватает тебя за плечи"], [40, 76.1, 77.16, "и шепчет:"], [41, 77.2, 78.66, "«Слушай внимательно."], [42, 78.7, 81.05999999999999, "Ты должен перестать убегать»."], [43, 81.1, 82.55999999999999, "Ты пытаешься вырваться,"], [44, 82.6, 84.75999999999999, "но он смотрит куда-то за твою спину."], [45, 84.8, 86.25999999999999, "Его лицо меняется."], [46, 86.3, 89.66, "Впервые он выглядит по-настоящему\nиспуганным."], [47, 89.7, 90.46, "«Нет."], [48, 90.5, 92.46, "Он нашёл нас обоих»."], [49, 92.5, 94.96, "Ты медленно поворачиваешь голову."], [50, 95.0, 96.36, "На крыше девятиэтажки"], [51, 96.4, 98.55999999999999, "стоит огромная чёрная фигура."], [52, 98.6, 100.05999999999999, "Она наклоняется вниз"], [53, 100.1, 102.36, "и произносит твоим голосом:"], [54, 102.4, 104.93, "«Кто из вас настоящий?»"], [55, 105.7, 106.05999999999999, "Чёрный экран."], [56, 106.1, 108.33, "Продолжение следует."]]